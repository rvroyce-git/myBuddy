[Unit]
Description=MyBuddy Telegram bot (lets website visitors subscribe to topics)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mybuddy
Group=mybuddy
WorkingDirectory=/home/mybuddy/app
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/mybuddy/app/.venv/bin/mybuddy bot
Restart=on-failure
RestartSec=30
# Exit code 78 = TELEGRAM_BOT_TOKEN not configured: don't restart in a loop.
RestartPreventExitStatus=78
# A long poll lasts up to 25 s; SIGTERM is handled after it returns.
TimeoutStopSec=45
# Keep the tiny 1 GB VM healthy
MemoryMax=150M
CPUQuota=25%
# Hardening (the bot only needs outbound HTTPS and its SQLite file)
UMask=0077
NoNewPrivileges=true
CapabilityBoundingSet=
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/mybuddy/.local/share/mybuddy
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallFilter=@system-service
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
